@startuml MODP Retirosteam TPI ASI

class Usuario {
    -nombre
    -apellido
    -email
    -teléfono
    -contraseña
    +crear()
    +modificar()
    +mostrarPerfil()
    +calcularGastoTotal()
}
class Retiro {
    -nombre
    -descripcion
    -fechaHoraRegistro
    -fechaHoraInicio
    -fechaHoraFin
    -actividades : Actividad
    -estado : EstadoRetiro
    -generoGrupo : GeneroGrupo
    -ubicacion : Ubicacion 
    -pago : Pago
    -precio
    -objetivosPersonales
    -tamañoGrupo
    -servicios
    -contactoOrganizador
    -nivelPrivacidad
    -comentarioAdicional
    -puntuacion
    -politicasCancelacion
    -mascotasPermitidas
    +crear()
    +consultar()
    +registrar()
    +modificar()
    +buscarRetiro(f: filtro)
    +obtenerCronograma()
    +cambiarEstado()
    +generarNotificacion()
    +generarPago()
    +obtenerRetirosActivos()
}
class Notificacion {
    -titulo
    -fechaHoraRegistro
    -descripción
    +mostrar()
    +crear()
    +tomarTitulo()
    +tomarFechaHoraRetiro()
    +tomarDescripcion()
    +obtenerTitulo()
    +obtenerFechaHoraRetiro()
    +obtenerDescripcion()
}
class Ubicacion {
    -pais
    -provincia
    -ciudad
    -departamento
    -calle
    -altura
    -piso
    +crear()
    +mostrar()
}
class Actividad {
    -nombre
    -descripcion
    +mostrar()
    +crear()
}
class ActividadProgramada {
    -actividad : Actividad
    -fechaHorainicio
    -fechaHorafin
    +mostrar()
    +crear()
}
class Pago {
    -monto
    -descripcion
    -destinatario
    -montoSeña
    -fechaHoraRegistro
    +mostrar()
    +crear()
    +calcularTotal()
}
class EstadoRetiro {
    -nombre
}
class GeneroGrupo {
    -nombre
}

Usuario "1" --> "0..*" Retiro : administra y agenda
Retiro "0..*" --> "1" Ubicacion : se realiza en
Retiro "1" *-- "0..*" ActividadProgramada : contiene
ActividadProgramada "0..*" --> "1" Actividad : corresponde a
Retiro "1" *-- "0..*" Pago : genera
Retiro "1" --> "0..*" Notificacion : genera
Retiro -left-> EstadoRetiro
Retiro -right-> GeneroGrupo
note top of Notificacion : Los métodos de esta clase\n se extienden a todo el diagrama
note top of EstadoRetiro : Inactivo\nActivo\npagoPendiente\nseñado\npagado
note top of GeneroGrupo : hombres\nmujeres\nmixto

@enduml
note top of Notificacion : Los métodos de esta clase\n se extienden a todo el diagrama

@enduml
