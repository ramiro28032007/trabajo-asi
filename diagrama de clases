@startuml MODP Retirosteam TPI ASI

class Usuario {
  -nombre
  -apellido
  -email
  -teléfono
  -contraseña
  +crear()
  +modificar()
  +mostrarPerfil()
  +calcularGastoTotal()
}
class Retiro {
  -nombre
  -descripcion
  -fechaHoraRegistro
  -fechaHoraInicio
  -fechaHoraFin
  -actividades : Actividad
  -estado : EstadoRetiro
  -generoGrupo : GeneroGrupo
  -ubicacion : Ubicacion 
  -objetivosPersonales
  -tamañoGrupo
  -servicios
  -contactoOrganizador
  -precio
  -nivelPrivacidad
  -comentarioAdicional
  -puntuacion
  -politicasCancelacion
  -mascotasPermitidas
  +crear()
  +consultar()
  +registrar()
  +modificar()
  +buscarRetiro(f: filtro)
  +obtenerCronograma()
  +cambiarEstado()
  +emitirNotificacion()
  +obtenerRetirosActivos()
}
enum EstadoRetiro as "EstadoRetiro" <<enumeration>> {
}
class EstadoRetiro {
  -inactivo
  -activo
  -pagoPendiente
  -señado
  -pagado
}
enum GeneroGrupo as "GeneroGrupo" <<enumeration>> {
}
class GeneroGrupo {
  -hombres
  -mujeres
  -mixto
}
class Notificacion {
  -titulo
  -fechaHoraRegistro
  -descripción
  +mostrar()
  +crear()
  +tomarTitulo()
  +tomarFechaHoraRetiro()
  +tomarDescripcion()
  +obtenerTitulo()
  +obtenerFechaHoraRetiro()
  +obtenerDescripcion()
}
class Ubicacion {
  -pais
  -provincia
  -ciudad
  -departamento
  -calle
  -altura
  -piso
  +crear()
  +mostrar()
}
class Actividad {
  -nombre
  -descripcion
  -fechaHorainicio
  -fechaHorafin
  +mostrar()
  +crear()
}

Usuario "1" --> "0..*" Retiro : administra y agenda
Retiro "0..*" --> "1" Ubicacion : se realiza en
Retiro "1" --* "0..*" Actividad : contiene
Retiro "1" --> "0..*" Notificacion : genera
Retiro -left-..> EstadoRetiro
Retiro -right-..> GeneroGrupo
note top of Notificacion : Los métodos de esta clase\n se extienden a todo el diagrama

@enduml
