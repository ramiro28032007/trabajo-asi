@startuml DC_v2
left to right direction
skinparam packageStyle rectangle
:Usuario: as U
:Sistema: as S
rectangle Retirosteam {
    (1.Registrar retiro)
    (2.Modificar retiro)
    (3.Consultar retiro)
    (4.Eliminar retiro)
    (5.Generar pago)
    (6.Registrar actividad)
    (7.Consultar actividades)
    (8.Enviar notificacion)
    (9.Dar de baja retiro)
    (10.Dar de alta retiro)
    (11.Consultar pago)
    (12.Registrar usuario)
    (13.Consultar usuario)
    (14.Modificar usuario)

    (4.Eliminar retiro)         .up.>(3.Consultar retiro):ext
    (2.Modificar retiro)        .up.>(3.Consultar retiro):ext
    (7.Consultar actividades)   .>(1.Registrar retiro):ext
    (7.Consultar actividades)   .>(2.Modificar retiro):ext
    (6.Registrar actividad)     .up.>(7.Consultar actividades):ext
    (5.Generar pago)            .up.>(2.Modificar retiro):ext
    (14.Modificar usuario)      .up.>(13.Consultar usuario):ext
    (12.Registrar usuario)      .up.>(13.Consultar usuario):ext
    (9.Dar de baja retiro)      .up.>(3.Consultar retiro):ext
    (10.Dar de alta retiro)     .up.>(3.Consultar retiro):ext

    S-->(8.Enviar notificacion)
    U-->(1.Registrar retiro)
    U-->(3.Consultar retiro)
    U-->(7.Consultar actividades)
    U-->(13.Consultar usuario)
    U-->(11.Consultar pago)
}
@enduml

